{
  "name": "bctk-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Tự động tạo vụ án theo biểu mẫu Báo cáo - thống kê (Hệ thống quản lý án)",
  "scripts": {
    "test": "playwright test",
    "staging": "playwright test",
    "staging:ui": "playwright test --ui",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "hinh-su": "playwright test src/tests/1-hinh-su",
    "dan-su": "playwright test src/tests/2-dan-su",
    "form:1A": "playwright test src/tests/1-hinh-su/form-1A",
    "form:1B": "playwright test --project=luong src/tests/1-hinh-su/form-1B",
    "form:1C": "playwright test src/tests/1-hinh-su/form-1C",
    "form:1D": "playwright test src/tests/1-hinh-su/form-1D",
    "form:2A": "playwright test src/tests/2-dan-su/form-2A",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "form:1B:headed": "playwright test --project=luong src/tests/1-hinh-su/form-1B --headed",
    "form:1B:ui": "playwright test --ui --project=luong src/tests/1-hinh-su/form-1B"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.3",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "typescript": "^5.6.3"
  }
}
