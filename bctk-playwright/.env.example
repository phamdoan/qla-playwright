#URL QLA
URL  =  https://qla-stg.toaan.gov.vn/sso/login

# ── .env: dùng cho các spec một tài khoản (1A, 1C, 1D, 2A) ──
# Luồng 1B KHÔNG dùng biến này: tài khoản lấy từ src/data/Tai-khoan/Taikhoan.xlsx, mật khẩu mặc định 123456
BCTK_USER=
# Bỏ trống → 123456
BCTK_PASS=
# Số vụ án tạo cho mỗi case trong file data JSON (1A, 1C, 1D, 2A)
BCTK_SO_LUONG=
# Luồng 1B khi data-1B.xlsx không có cột "Luồng": khang-cao | khang-nghi (mặc định theo form-1B.xlsx)
BCTK_LUONG=
# Số đơn 10A tạo mỗi lần chạy (Đơn 01, Đơn 02…); bỏ trống → theo "Số đơn tạo mỗi lần chạy" trong form-10A.xlsx
BCTK_SO_DON=
# Số vụ án 1A1 tạo mỗi lần chạy (Vụ 01, Vụ 02…); bỏ trống → theo "Số vụ tạo mỗi lần chạy" trong form-1A1.xlsx
BCTK_SO_VU=

# ── .env.<hồ sơ>: link đăng nhập theo môi trường (staging | dev | uat | preprod) ──
# vd. .env.staging:
#   URL=https://qla-stg.toaan.gov.vn/sso/login
# Chọn hồ sơ: npm run staging | dev | ... hoặc đặt BCTK_HO_SO; mặc định staging.
