# Sao chép thành .env rồi điền tài khoản.
# Môi trường: stg (mặc định) | dev | uat | preprod — hoặc truyền thẳng URL, vd. http://localhost:8000
BCTK_ENV=stg
# Tài khoản đăng nhập SSO (số CCCD); mật khẩu bỏ trống → Ta@<user>
BCTK_USER=
BCTK_PASS=
# Số vụ án tạo cho mỗi case trong file data (ghi đè "soLuong" trong JSON nếu đặt)
BCTK_SO_LUONG=
