# Sao chép thành .env.dev / .env.staging / .env.preprod (npm run dev|staging|preprod[:ui]) hoặc .env (npx playwright test)
# Môi trường: stg | dev | uat | preprod (preprod = https://e-qlta-uat.toaan.gov.vn)
#
# Test ĐĂNG NHẬP (tests/dang-nhap/dang-nhap.spec.ts) không dùng các biến dưới đây: tài khoản khai
# ở config/tai-khoan-dang-nhap.local.json. Chạy: npm run dang-nhap preprod
QLA_ENV=dev
# Tài khoản đăng nhập SSO (số CCCD); mật khẩu bỏ trống → Ta@<user>
QLA_LOGIN_USER=
QLA_LOGIN_PASS=
# Các vai: QLA_CANBO_USER, QLA_TRUONGPHONG_USER, QLA_CHANHVP_USER, QLA_CHANHAN_USER, QLA_TTV_USER, QLA_LANHDAOVU_USER

# ── Luồng "Thêm mới đơn theo bản án sơ thẩm" (Luông nhập data.txt) – biến RIÊNG, không dùng chung ở trên ──
# Tài khoản nhập đơn (số CCCD); mật khẩu bỏ trống → Ta@<CCCD>
QLA_TKM_USER=
QLA_TKM_PASS=
# '1' = môi trường được phép tạo đơn thật (chỉ đặt cho DEV). STG để trống ⇒ chỉ đăng nhập + đối chiếu quyền.
QLA_TKM_CHO_PHEP_GHI=
# Chọn dòng dữ liệu Excel chạy trên giao diện: QLA_TKM_SO_DONG=3 (3 dòng đầu) hoặc QLA_TKM_DONG=2,5,25
QLA_TKM_SO_DONG=1
# Đổi file dữ liệu nếu cần (mặc định e2e/data/*.xlsx)
QLA_TKM_FILE_INPUT=
QLA_TKM_FILE_DOI_CHIEU=
# STG có bộ bản án tham chiếu ⇒ thiếu là lỗi thật (DEV chưa có nên để trống, test tự bỏ qua)
QLA_TKM_BAT_BUOC_CO_DU_LIEU=
